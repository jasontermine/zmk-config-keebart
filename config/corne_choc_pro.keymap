#include "keys_de_swiss.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    macros {
        windowtab: windowtab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp RALT>;

            label = "WINDOWTAB";
        };

        spotlight: spotlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "SPOTLIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE        &kp DE_Q  &kp DE_W  &kp DE_F  &kp DE_P     &kp DE_B  &none  &none  &kp DE_J  &kp DE_L       &kp DE_U      &kp DE_Y    &kp DE_SEMICOLON  &kp CAPSLOCK
&kp LEFT_SHIFT    &kp DE_A  &kp DE_R  &kp DE_S  &kp DE_T     &kp DE_G  &none  &none  &kp DE_M  &kp DE_N       &kp DE_E      &kp DE_I    &kp DE_O          &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp DE_Z  &kp DE_X  &kp DE_C  &kp DE_D     &kp DE_V                &kp DE_K  &kp DE_H       &kp DE_COMMA  &kp DE_DOT  &kp DE_SLASH      &kp LGUI
                                      &mo 3     &lt 2 SPACE  &kp TAB                 &kp RET   &kp BACKSPACE  &mo 1
            >;
        };

        SYM {
            display-name = "Symbols";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&trans  &kp DE_CARET         &kp DE_SINGLE_QUOTE       &kp DE_DOUBLE_QUOTES  &kp DE_GRAVE          &kp DE_TILDE      &none  &none  &kp DE_AT        &kp DE_PLUS         &kp DE_ASTERISK   &kp DE_EQUAL  &kp DE_UNDERSCORE  &trans
&trans  &kp DE_LESS_THAN     &kp DE_LEFT_PARENTHESIS   &kp DE_LEFT_BRACE     &kp DE_LEFT_BRACKET   &kp DE_BACKSLASH  &none  &none  &kp DE_QUESTION  &kp DE_EXCLAMATION  &kp DE_AMPERSAND  &kp DE_PIPE   &kp DE_MINUS       &trans
&trans  &kp DE_GREATER_THAN  &kp DE_RIGHT_PARENTHESIS  &kp DE_RIGHT_BRACE    &kp DE_RIGHT_BRACKET  &kp DE_SLASH                    &kp DE_DOLLAR    &kp DE_PERCENT      &kp DE_COLON      &kp DE_HASH   &kp DE_SLASH       &trans
                                                       &trans                &spotlight            &windowtab                      &trans           &trans              &trans
            >;
        };

        NUM {
            display-name = "Numbers";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&trans  &none  &kp F9  &kp F10  &kp F11  &kp F12  &none  &none  &kp DE_N0          &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp DE_ASTERISK  &kp KP_NUMLOCK
&trans  &none  &kp F5  &kp F6   &kp F7   &kp F8   &none  &none  &kp DE_MINUS       &kp DE_N4  &kp DE_N5  &kp DE_N6  &kp DE_SLASH     &trans
&trans  &none  &kp F1  &kp F2   &kp F3   &kp F3                 &kp DE_UNDERSCORE  &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_DOT       &trans
                       &trans   &trans   &trans                 &trans             &trans     &trans
            >;
        };

        NAV {
            display-name = "Navigation";
            bindings = <
&kp ESC    &none            &none  &none   &none   &none    &none  &none  &none   &kp DE_U_UMLAUT  &trans          &kp DE_O_UMLAUT  &none  &trans
&kp LSHFT  &kp DE_A_UMLAUT  &none  &none   &none   &none    &none  &none  &none   &kp HOME         &kp UP_ARROW    &kp END          &none  &trans
&kp LCTRL  &none            &none  &none   &none   &none                  &none   &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &trans
                                   &trans  &trans  &kp TAB                &trans  &kp DEL          &trans
            >;
        };

        SYS {
            display-name = "System";
            bindings = <
&trans  &trans        &trans        &trans        &trans      &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans
&trans  &trans        &trans        &trans        &trans      &studio_unlock  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bt BT_CLR_ALL                  &trans  &trans  &trans  &trans  &bootloader  &trans
                                    &trans        &trans      &trans                          &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        System {
            if-layers = <1 3>;
            then-layer = <4>;
        };
    };
};
